# Chat Service Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
# For tunneling services (Pinggy, Ngrok, etc.), use "*" to allow all origins
# For production, specify exact origins
CORS_ORIGIN=*

# JWT Secret (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Database (if using PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/multilingual_chat

# Service URLs
TRANSLATION_SERVICE_URL=http://localhost:3003
STT_SERVICE_URL=http://localhost:3004
TTS_SERVICE_URL=http://localhost:3005
