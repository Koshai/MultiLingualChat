# ===========================================
# DEVELOPMENT CONFIGURATION (Current Setup)
# ===========================================

# STT Service (Speech-to-Text)
STT_PROVIDER=whisper  # whisper (local/free), google, azure, aws

# Whisper Model Selection
# - tiny (72MB): Fastest, lowest accuracy - good for testing
# - base (142MB): Fast, basic accuracy
# - small (466MB): Balanced speed/accuracy
# - medium (1.42GB): High accuracy - good for Spanish, French, German
# - large (2.87GB): Best accuracy - RECOMMENDED for Bengali, Hindi, Arabic, Japanese
WHISPER_MODEL=large

# For faster processing with lower accuracy (English, Spanish only):
# WHISPER_MODEL=medium

# Translation Service
TRANSLATION_PROVIDER=argos  # argos (local/free), google, deepl, azure

# ===========================================
# PRODUCTION CONFIGURATION (Commercial APIs)
# ===========================================
# Uncomment and configure when moving to production

# --- Google Cloud Services ---
# GOOGLE_CLOUD_PROJECT_ID=your-project-id
# GOOGLE_CLOUD_CREDENTIALS_PATH=/path/to/credentials.json

# --- Azure Services ---
# Azure Cognitive Services - Speech-to-Text
# AZURE_SPEECH_KEY=your-speech-key
# AZURE_SPEECH_REGION=eastus

# Azure Translator (FREE TIER: 2M chars/month)
# Sign up: https://portal.azure.com/#create/Microsoft.CognitiveServicesTextTranslation
# After creating resource, get key from Keys and Endpoint section
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global

# --- AWS Services ---
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# --- DeepL Translation (Best Quality) ---
# DEEPL_API_KEY=your-api-key
# DEEPL_API_FREE=true  # false for pro account

# ===========================================
# DATABASE & INFRASTRUCTURE
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/multilingual_chat
REDIS_URL=redis://localhost:6379

# ===========================================
# SERVICE PORTS
# ===========================================
CHAT_SERVICE_PORT=3001
STT_SERVICE_PORT=3004
TRANSLATION_SERVICE_PORT=3003
FRONTEND_PORT=5174
