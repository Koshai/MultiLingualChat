# Local Development Environment Variables
# Copy this file to .env and update values as needed

# Database Configuration (Local PostgreSQL instance)
POSTGRES_DB=multilingual_chat
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/multilingual_chat

# For local development without PostgreSQL, you can use SQLite:
# DATABASE_URL=sqlite:./dev.db

# Redis Configuration (Local Redis instance)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# For local development without Redis, services will work without caching

# Chat Service Configuration
CHAT_SERVICE_PORT=3001
CHAT_SERVICE_HOST=0.0.0.0

# Translation Service Configuration
TRANSLATION_SERVICE_PORT=3003
TRANSLATION_SERVICE_HOST=0.0.0.0

# LibreTranslate Configuration
# For local development, you can:
# 1. Install LibreTranslate locally: pip install libretranslate
# 2. Use a cloud service like Google Translate API
# 3. Use a mock translation service for development
LIBRETRANSLATE_URL=http://localhost:5000

# Frontend Configuration (Vite dev server runs on 5173)
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001
VITE_TRANSLATION_API_URL=http://localhost:3003/api/v1

# Legacy React env vars (if needed)
REACT_APP_CHAT_SERVICE_URL=http://localhost:3001
REACT_APP_TRANSLATION_SERVICE_URL=http://localhost:3003
REACT_APP_WS_URL=ws://localhost:3001

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CORS_ORIGIN=http://localhost:5173

# LibreTranslate Configuration
LT_DISABLE_WEB_UI=false
LT_LOAD_ONLY=en,es,fr,de,it,pt,ru,zh,ja,ko

# Node Environment
NODE_ENV=development

# Optional: Mock translation for development without LibreTranslate
USE_MOCK_TRANSLATION=false