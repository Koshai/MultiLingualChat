# Network Mode Configuration
# Copy this to .env when doing network demo with multiple computers

# IMPORTANT: Replace YOUR_IP_HERE with your actual network IP
# Find it by running: ipconfig (look for IPv4 Address)
# Example: 192.168.1.100
HOST_IP=YOUR_IP_HERE

# Database Configuration (Local PostgreSQL instance)
POSTGRES_DB=multilingual_chat
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/multilingual_chat

# Redis Configuration (Local Redis instance)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Chat Service Configuration (bind to all interfaces for network access)
CHAT_SERVICE_PORT=3001
CHAT_SERVICE_HOST=0.0.0.0

# Translation Service Configuration
TRANSLATION_SERVICE_PORT=3003
TRANSLATION_SERVICE_HOST=0.0.0.0
TRANSLATION_SERVICE_URL=http://${HOST_IP}:3003

# STT Service Configuration
STT_SERVICE_PORT=3004
STT_SERVICE_HOST=0.0.0.0
STT_SERVICE_URL=http://${HOST_IP}:3004

# TTS Service Configuration
TTS_SERVICE_PORT=3005
TTS_SERVICE_HOST=0.0.0.0
TTS_SERVICE_URL=http://${HOST_IP}:3005

# Frontend Configuration (Network Mode)
# IMPORTANT: Update HOST_IP to your network IP address!
VITE_API_URL=http://${HOST_IP}:3001/api
VITE_WS_URL=ws://${HOST_IP}:3001
VITE_TRANSLATION_API_URL=http://${HOST_IP}:3003/api/v1

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
CORS_ORIGIN=*

# Azure Translator (FREE TIER: 2M chars/month)
AZURE_TRANSLATOR_KEY=G2M9haltXmmfxA8HPEMIeBxYAumFKjAyFd8mh2rULtLJn4T6Jao4JQQJ99BKACYeBjFXJ3w3AAAbACOGqONe
AZURE_TRANSLATOR_REGION=eastus

# Azure Speech-to-Text (FREE TIER: 5 audio hours/month)
AZURE_SPEECH_KEY=5moiJV0IRs0DuCiAyQ4nz83GYh3rBAbbHgRvNL3Zul9qcnmjbQgwJQQJ99BKACYeBjFXJ3w3AAAYACOGejUV
AZURE_SPEECH_REGION=eastus

# Speech-to-Text Configuration (Whisper - fallback)
WHISPER_MODEL=medium
DEVICE=cpu

# Node Environment
NODE_ENV=development
